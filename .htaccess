<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /petron_system/

    # Canonical redirect:
    # /public/admin/app.php -> /public/admin/app
    RewriteCond %{THE_REQUEST} \s/+petron_system/([^\s?]+?)\.php(?:[\s?]|$) [NC]
    RewriteRule ^ %1 [R=301,L,NE]

    # Keep direct access for existing files/folders (assets, images, js, css, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Allow extensionless PHP URLs:
    # /public/admin/app -> /public/admin/app.php
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>
